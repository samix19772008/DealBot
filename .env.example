DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# Optional absolute or project-relative SQLite path. Defaults to data/escrow.sqlite.
# DATABASE_PATH=data/escrow.sqlite
# Optional local heartbeat path used by npm run health.
# HEALTH_STATUS_PATH=data/health.json
# Automatic verified backups: 0 disables scheduling; 1 to 168 schedules every N hours.
# Deployment examples set 24 and also take a verified snapshot on startup.
BACKUP_INTERVAL_HOURS=0
# Optional backup folder; defaults to the database folder's backups/ directory.
# BACKUP_DIRECTORY=data/backups
